using UnityEngine;
using System.Runtime.InteropServices;

public class ComputeMeshModifier : MonoBehaviour
{
    public ComputeShader computeShader;
    public Transform[] pathPoints; // Points that define the cylinder path
    public float radius = 1f;

    private ComputeBuffer inputVertexBuffer;
    private ComputeBuffer segmentBuffer;
    private ComputeBuffer outputVertexBuffer;
    private ComputeBuffer outputIndexBuffer;

    private int vertexStride = Marshal.SizeOf(typeof(VertexData));
    private int indexStride = sizeof(int);

    [StructLayout(LayoutKind.Sequential)]
    struct VertexData
    {
        public Vector3 position;
        public Vector3 normal;
        public Vector2 uv;
    }

    void Start()
    {
        Mesh circleMesh = GetComponent<MeshFilter>().sharedMesh;

        // Extract circle vertex data
        Vector3[] positions = circleMesh.vertices;
        Vector3[] normals = circleMesh.normals;
        Vector2[] uvs = circleMesh.uv;
        int[] sourceIndices = circleMesh.triangles;

        int circleVertexCount = positions.Length;

        // Convert to compute format
        VertexData[] inputVertices = new VertexData[circleVertexCount];
        for (int i = 0; i < circleVertexCount; i++)
        {
            inputVertices[i] = new VertexData
            {
                position = positions[i],
                normal = normals[i],
                uv = uvs[i]
            };
        }

        // Convert path points to world-space positions
        Vector3[] segmentPoints = new Vector3[pathPoints.Length];
        for (int i = 0; i < pathPoints.Length; i++)
        {
            segmentPoints[i] = pathPoints[i].position;
        }

        int ringCount = segmentPoints.Length;
        int totalVertices = circleVertexCount * ringCount;
        int totalQuads = (circleVertexCount - 1) * (ringCount - 1);
        int totalIndices = totalQuads * 6;

        // Setup buffers
        inputVertexBuffer = new ComputeBuffer(circleVertexCount, vertexStride);
        segmentBuffer = new ComputeBuffer(ringCount, sizeof(float) * 3);
        outputVertexBuffer = new ComputeBuffer(totalVertices, vertexStride);
        outputIndexBuffer = new ComputeBuffer(totalIndices, indexStride);

        inputVertexBuffer.SetData(inputVertices);
        segmentBuffer.SetData(segmentPoints);

        // Run compute shader
        int kernel = computeShader.FindKernel("CSMain");
        computeShader.SetInt("circleVertexCount", circleVertexCount);
        computeShader.SetInt("ringCount", ringCount);
        computeShader.SetFloat("radius", radius);

        computeShader.SetBuffer(kernel, "inputVertices", inputVertexBuffer);
        computeShader.SetBuffer(kernel, "segmentPositions", segmentBuffer);
        computeShader.SetBuffer(kernel, "outputVertices", outputVertexBuffer);
        computeShader.SetBuffer(kernel, "outputIndices", outputIndexBuffer);

        int threadGroups = Mathf.CeilToInt(totalVertices / 64f);
        computeShader.Dispatch(kernel, threadGroups, 1, 1);

        // Read back
        VertexData[] finalVertices = new VertexData[totalVertices];
        int[] finalIndices = new int[totalIndices];
        outputVertexBuffer.GetData(finalVertices);
        outputIndexBuffer.GetData(finalIndices);

        // Build mesh
        Vector3[] verts = new Vector3[totalVertices];
        Vector3[] norms = new Vector3[totalVertices];
        Vector2[] uvsFinal = new Vector2[totalVertices];

        for (int i = 0; i < totalVertices; i++)
        {
            verts[i] = finalVertices[i].position;
            norms[i] = finalVertices[i].normal;
            uvsFinal[i] = finalVertices[i].uv;
        }

        Mesh mesh = new Mesh();
        mesh.vertices = verts;
        mesh.normals = norms;
        mesh.uv = uvsFinal;
        mesh.triangles = finalIndices;

        GetComponent<MeshFilter>().mesh = mesh;

        inputVertexBuffer.Release();
        segmentBuffer.Release();
        outputVertexBuffer.Release();
        outputIndexBuffer.Release();
    }
}
